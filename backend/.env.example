# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/notebooklm_audio?schema=public"

# Redis (for job queue)
REDIS_HOST=localhost
REDIS_PORT=6379

# AI Services - Choose one or both for script generation
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# TTS Service - Choose one
# Option 1: ElevenLabs (Recommended for quality)
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
ELEVENLABS_VOICE_1=voice-id-for-alex
ELEVENLABS_VOICE_2=voice-id-for-jordan

# Option 2: OpenAI TTS (Alternative)
# OPENAI_TTS_VOICE_1=alloy
# OPENAI_TTS_VOICE_2=echo

# File Storage
UPLOAD_DIR=./uploads
AUDIO_DIR=./audio
MAX_FILE_SIZE=52428800

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
